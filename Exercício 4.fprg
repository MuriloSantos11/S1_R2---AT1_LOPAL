    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N&#250;mero" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero&quot;" newline="True"/>
            <input variable="N&#250;mero"/>
            <if expression="N&#250;mero = 0">
                <then>
                    <output expression="&quot;Este n&#250;mero equivale a 0&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="N&#250;mero &gt; 0">
                        <then>
                            <output expression="&quot;Este n&#250;mero &#233; positivo&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Este n&#250;mero &#233; negativo&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
